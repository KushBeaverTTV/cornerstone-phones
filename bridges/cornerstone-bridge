#!/usr/bin/env python3
"""One headset's bridge to the shell. See BRIDGE.md, and core/runtime.py."""
import os
import sys

# Anything written inside the plugin folder makes the shell reload the
# plugin, so the bridge must leave no __pycache__ behind.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from core import runtime  # noqa: E402

if __name__ == "__main__":
    sys.exit(runtime.main(sys.argv[1:]))
