#!/usr/bin/env python3
"""The Fast Pair reader, one process for every followed device. See fastpair.py."""
import os
import sys

# Anything written inside the plugin folder makes the shell reload the
# plugin, so the reader must leave no __pycache__ behind.
sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

import fastpair  # noqa: E402

if __name__ == "__main__":
    sys.exit(fastpair.main(sys.argv[1:]))
