#!/usr/bin/env python3
"""Exercise a connected headset through the running bar, and put it back.

    tools/live-check <which>        e.g. tools/live-check moto

<which> is any word the IPC takes (part of the name, the address, or the
backend). Reads the battery, then sets every listening mode the headset
offers, waiting each time for the headset itself to report it, and finally
restores the mode it started in. Changes what you hear while it runs.
"""
import subprocess
import sys
import time


def ipc(*args):
    return subprocess.check_output(["omarchy-shell", "cornerstone-phones", *map(str, args)],
                                   text=True, timeout=8).strip()


def wait_for(which, mode, seconds=15):
    deadline = time.monotonic() + seconds
    while True:
        now = ipc("modeFor", which)
        if now == mode:
            return True
        if time.monotonic() > deadline:
            return False
        time.sleep(0.25)


def main():
    if len(sys.argv) != 2:
        sys.exit(__doc__.strip())
    which = sys.argv[1]
    print("status   ", ipc("statusFor", which))
    for part in ("batteryFor", "leftFor", "rightFor", "batteryCaseFor", "chargingFor"):
        print("%-9s" % part[:-3], ipc(part, which))
    start = ipc("modeFor", which)
    print("mode      %s" % start)
    if start in ("pending", "unsupported"):
        sys.exit("no listening mode to exercise (%s)" % start)
    modes = [m for m in ipc("modesFor", which).split(",") if m]
    print("offers    %s" % ", ".join(modes))
    failures = 0
    try:
        for mode in modes + [start]:
            answer = ipc("setModeFor", mode, which)
            ok = answer == "ok" and wait_for(which, mode)
            failures += not ok
            print("set %-10s %s" % (mode, "reported" if ok else "FAILED (%s, now %s)" % (answer, ipc("modeFor", which))))
    finally:
        if ipc("modeFor", which) != start:
            ipc("setModeFor", start, which)
    sys.exit(1 if failures else 0)


if __name__ == "__main__":
    main()
