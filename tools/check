#!/usr/bin/env python3
"""Everything a change to Cornerstone Phones is held to, in one command.

    tools/check               compare pins with main
    CHECK_BASE=<ref> tools/check

One line per check, "ok", "FAIL" or "skipped" with the reason; exit 1 if
anything failed. A check whose tool is missing here (deno, the Omarchy shell)
is skipped and says so.
"""
import ast
import glob
import json
import os
import re
import shutil
import subprocess
import sys

ROOT = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), ".."))
os.chdir(ROOT)
# Anything written inside the plugin folder reloads the plugin in the shell.
ENV = dict(os.environ, PYTHONDONTWRITEBYTECODE="1")
failed = []


def say(status, what, detail=""):
    print("%-8s %s" % (status, what))
    if detail:
        print("\n".join("         " + line for line in detail.rstrip().splitlines()[-40:]))
    if status == "FAIL":
        failed.append(what)


def run(argv):
    result = subprocess.run(argv, capture_output=True, text=True, env=ENV)
    return result.returncode, result.stdout + result.stderr


def python_sources():
    files = glob.glob("bridges/**/*.py", recursive=True) + glob.glob("tests/*.py") + glob.glob("tools/*")
    files += ["bridges/cornerstone-bridge", "bridges/cornerstone-fastpair"]
    out = []
    for path in sorted(set(files)):
        if not os.path.isfile(path):
            continue
        with open(path, "rb") as handle:
            head = handle.readline()
        if path.endswith(".py") or b"python" in head:
            out.append(path)
    return out


# ---- Python parses (ast, so no bytecode is written).
problems = []
for path in python_sources():
    try:
        ast.parse(open(path).read(), path)
    except SyntaxError as error:
        problems.append("%s: %s" % (path, error))
say("FAIL" if problems else "ok", "python syntax", "\n".join(problems))

# ---- The Python tests, pins included.
code, out = run([sys.executable, "-m", "unittest", "discover", "-s", "tests", "-t", ".", "-p", "test_*.py"])
count = re.search(r"Ran (\d+) tests", out)
say("ok" if code == 0 else "FAIL", "python tests (%s)" % (count.group(1) if count else "?"),
    "" if code == 0 else out)

# ---- The JavaScript tests.
if shutil.which("deno"):
    code, out = run(["deno", "test", "--allow-read", "tests/js/"])
    passed = re.search(r"(\d+) passed", out)
    say("ok" if code == 0 else "FAIL", "js tests (%s)" % (passed.group(1) if passed else "?"),
        "" if code == 0 else out)
else:
    say("skipped", "js tests: deno is not installed")

# ---- Every brand has a module, a test file and a pin; every pin is well
#      formed and belongs to a brand.
sys.path.insert(0, "bridges")
sys.dont_write_bytecode = True
from brands import NAMES  # noqa: E402

problems = []
for brand in NAMES:
    if not os.path.isfile("bridges/brands/%s.py" % brand):
        problems.append("no bridges/brands/%s.py" % brand)
    if not os.path.isfile("tests/test_%s.py" % brand):
        problems.append("no tests/test_%s.py" % brand)
    if not glob.glob("tests/pins/%s/*.json" % brand):
        problems.append("no pin under tests/pins/%s/" % brand)
for path in sorted(glob.glob("tests/pins/*/*.json")):
    brand = os.path.basename(os.path.dirname(path))
    try:
        pin = json.load(open(path))
    except ValueError as error:
        problems.append("%s: not JSON: %s" % (path, error))
        continue
    for key in ("model", "owner", "bridge", "steps"):
        if key not in pin:
            problems.append("%s: no %r" % (path, key))
    # Pins written before the rewrite name the old "<brand>-bridge" script.
    if pin.get("bridge") not in (brand, brand + "-bridge"):
        problems.append("%s: says bridge %r, sits under %s/" % (path, pin.get("bridge"), brand))
    if brand not in NAMES:
        problems.append("%s: there is no brand %s" % (path, brand))
    if pin.get("capture") and not os.path.exists(pin["capture"]):
        problems.append("%s: names capture %s, which does not exist" % (path, pin["capture"]))
say("FAIL" if problems else "ok", "brands, tests and pins line up", "\n".join(problems))

# ---- Pins may be added, never edited or removed: each is somebody's
#      headphones, and nobody here can retest another owner's model.
base = os.environ.get("CHECK_BASE", "")
if not base:
    for ref in ("origin/main", "main"):
        if run(["git", "rev-parse", "-q", "--verify", ref])[0] == 0:
            base = ref
            break
if not base:
    say("skipped", "pins unchanged: no main to compare with")
else:
    _, since = run(["git", "merge-base", base, "HEAD"])
    _, changed = run(["git", "diff", "--diff-filter=MDR", "--name-only", since.strip(), "--", "tests/pins"])
    changed = [line for line in changed.splitlines() if line.strip()]
    say("FAIL" if changed else "ok", "pins unchanged since %s" % base, "\n".join(changed))

# ---- Text a person reads: no em dashes, and every Text is plain text.
problems = []
texts = glob.glob("*.qml") + glob.glob("parts/*.qml") + glob.glob("lib/*.js") + ["manifest.json", "README.md"]
texts += glob.glob("bridges/**/*.py", recursive=True)
for path in texts:
    for number, line in enumerate(open(path, encoding="utf-8"), 1):
        if "—" in line or "\\u2014" in line:
            problems.append("%s:%d has an em dash" % (path, number))
for path in glob.glob("*.qml") + glob.glob("parts/*.qml"):
    source = open(path).read()
    for match in re.finditer(r"\n(\s*)Text \{\n(.*?)\n\1\}", source, re.S):
        if "textFormat: Text.PlainText" not in match.group(2):
            line = source[:match.start()].count("\n") + 2
            problems.append("%s:%d: a Text without textFormat: Text.PlainText" % (path, line))
say("FAIL" if problems else "ok", "user-facing text", "\n".join(problems))

# ---- manifest.json parses and has a version.
try:
    version = json.load(open("manifest.json"))["version"]
    say("ok", "manifest.json (%s)" % version)
except (ValueError, KeyError) as error:
    say("FAIL", "manifest.json", str(error))

# ---- The shell's own validation, where Omarchy is installed.
if shutil.which("omarchy"):
    code, out = run(["omarchy", "plugin", "validate", "."])
    say("ok" if code == 0 else "FAIL", "omarchy plugin validate", "" if code == 0 else out)
else:
    say("skipped", "omarchy plugin validate: no Omarchy here")

if failed:
    print("\n%d check(s) failed." % len(failed))
sys.exit(1 if failed else 0)
