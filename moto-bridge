#!/usr/bin/env python3
"""Hold one RFCOMM link to Motorola Moto Buds and mirror listening mode + battery.

    moto-bridge <classic-address> <reported-name>

Prints one JSON object per line; reads one command per line (BRIDGE.md):

    stdout   {"modes": true, "mode": "anc",
              "available": ["off","anc","ambient"],
              "battery": {"left": 92, "right": 90}}
    stdin    set off | set anc | set ambient

Exit codes: 0 clean, 1 transient, 3 linked-but-silent, 4 setup.

Protocol confirmed on Moto Buds+ (XT2441-1 / "moto buds+") 2026-11-09:
RFCOMM profile UUID fc9d9fe0-4899-11ee-be56-0242ac120002 (BlueZ NewConnection).
Framing HEAD…TAIL with CRC32 over the packet before CRC (see PROTOCOL note below).

    opcode 0x0005 battery reply payload: L, R, case (0xFF = not reporting)
    opcode 0x0200 ANC read payload: mode, sub_mode
             0x00 off · 0x01 ANC · 0x02 transparency/ambient
    opcode 0x0201 ANC set payload: mode, sub_mode
    opcode 0x0204 ANC changed notification
    opcode 0x0009 battery changed notification

Handshake: 0x0000 (profile), optional 0x000B / 0x0010 as the Android app does.
"""
import binascii
import ctypes
import json
import os
import re
import signal
import struct
import sys

try:
    import dbus
    import dbus.mainloop.glib
    import dbus.service
    from gi.repository import GLib
except ImportError as error:
    sys.stdout.write(json.dumps({
        "modes": False,
        "error": "missing python dependency %s"
                 % (getattr(error, "name", None) or error),
    }) + "\n")
    sys.stdout.flush()
    sys.exit(4)

try:
    from gi.repository import GLibUnix
    unix_signal_add = GLibUnix.signal_add
except ImportError:
    unix_signal_add = GLib.unix_signal_add

USAGE = "usage: moto-bridge <classic-address> <reported-name>"
ADDRESS = re.compile(r"^([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}$")
# Control channel UUID from the buds' SDP record / Moto app.
UUID = "fc9d9fe0-4899-11ee-be56-0242ac120002"
PROFILE_PATH = "/io/cornerstone/phones/moto"

# Exact bluetoothctl Alias / Name as seen on this machine.
MODELS = {
    "moto buds+": {
        "available": ["off", "anc", "ambient"],
        # set payload (mode, sub_mode) as answered/accepted by this unit
        "set": {
            "off": bytes([0x00, 0x00]),
            "anc": bytes([0x01, 0x01]),
            "ambient": bytes([0x02, 0x00]),
        },
    },
    # Same protocol family (Moto Buds / Bass) — only listed once we can confirm
    # names; keep + as the only shipped row until other owners confirm.
}

HEAD = b"HEAD"
TAIL = b"TAIL"
TYPE_REQ = 0x80
TYPE_RSP = 0x20
TYPE_NTF = 0x40

OP_PROFILE = 0x0000
OP_BATTERY = 0x0005
OP_BATTERY_NTF = 0x0009
OP_FEATURES = 0x000B
OP_ACCOUNT = 0x0010
OP_ANC_GET = 0x0200
OP_ANC_SET = 0x0201
OP_ANC_NTF = 0x0204

MODE_FROM_BYTE = {0x00: "off", 0x01: "anc", 0x02: "ambient"}

EXIT_TRANSIENT = 1
EXIT_UNSUPPORTED = 3
EXIT_SETUP = 4

CONNECT_TIMEOUT = 30
CONNECT_DELAY = 500
CONNECT_RETRY = 1500
CONNECT_ATTEMPTS = 10
FIRST_ANSWER_MS = 6000
POLL_MS = 15000
ASK_AGAIN_MS = 2000


def emit(payload):
    try:
        sys.stdout.write(json.dumps(payload, separators=(",", ":")) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, ValueError):
        os._exit(0)


def arm_parent_death_signal():
    try:
        libc = ctypes.CDLL("libc.so.6", use_errno=True)
        libc.prctl(1, signal.SIGTERM)
    except Exception:
        return
    if os.getppid() == 1:
        os._exit(0)


def encode(opcode, payload=b"", seq=0):
    packet = bytearray()
    packet.extend(HEAD)
    packet.extend((8 + len(payload)).to_bytes(2, "little"))
    packet.extend(int(opcode).to_bytes(2, "big"))
    packet.append(TYPE_REQ)
    packet.append(0x00)
    packet.extend(len(payload).to_bytes(2, "little"))
    packet.extend(int(seq).to_bytes(2, "little"))
    packet.extend(payload)
    crc = binascii.crc32(packet) & 0xFFFFFFFF
    packet.extend(struct.pack("<I", crc))
    packet.extend(TAIL)
    return bytes(packet)


def take_frames(buffer):
    """Pull whole HEAD…TAIL PDUs; return list of (opcode, type, result, payload)."""
    frames = []
    while True:
        try:
            start = buffer.index(HEAD)
        except ValueError:
            buffer.clear()
            break
        if start:
            del buffer[:start]
        if len(buffer) < 12:
            break
        payload_len = int.from_bytes(buffer[10:12], "little")
        total = 4 + 2 + 2 + 1 + 1 + 2 + 2 + payload_len + 4 + 4
        if len(buffer) < total:
            break
        raw = bytes(buffer[:total])
        del buffer[:total]
        if raw[-4:] != TAIL:
            continue
        # Live Moto Buds+ replies put 0 in the CRC field; the Android framing
        # still carries the slot. Accept any CRC so we do not drop every answer.
        opcode = int.from_bytes(raw[6:8], "big")
        typ = raw[8]
        result = raw[9]
        payload = raw[14:14 + payload_len]
        frames.append((opcode, typ, result, payload))
    return frames


def find_device_path(bus, address):
    wanted = address.upper()
    managed = bus.get_object("org.bluez", "/")
    objects = dbus.Interface(managed, "org.freedesktop.DBus.ObjectManager").GetManagedObjects()
    for path, interfaces in objects.items():
        device = interfaces.get("org.bluez.Device1")
        if device and str(device.get("Address", "")).upper() == wanted:
            return str(path)
    return None


def parse_battery(payload):
    """left/right/case 0-100; 0xFF means not reporting."""
    if len(payload) < 2:
        return None
    out = {}
    names = ("left", "right", "case")
    for i, name in enumerate(names):
        if i >= len(payload):
            break
        level = payload[i]
        if level <= 100:
            out[name] = int(level)
    return out or None


def parse_anc(payload):
    if not payload:
        return None
    return MODE_FROM_BYTE.get(payload[0])


class Bridge:
    def __init__(self, bus, address, name, loop):
        self.bus = bus
        self.address = address
        self.model = MODELS[name]
        self.loop = loop
        self.exit_code = None
        self.device = None
        self.manager = None
        self.registered = False
        self.fd = None
        self.watch = None
        self.buffer = bytearray()
        self.mode = None
        self.battery = None
        self.last_line = None
        self.seq = 0

    def finish(self, code, message=None):
        if self.exit_code is not None:
            return False
        self.exit_code = code
        if message:
            emit({"modes": False, "error": message})
        self.loop.quit()
        return False

    def unregister(self):
        if self.watch is not None:
            try:
                GLib.source_remove(self.watch)
            except Exception:
                pass
            self.watch = None
        if self.fd is not None:
            try:
                os.close(self.fd)
            except OSError:
                pass
            self.fd = None
        if self.manager is not None and self.registered:
            try:
                self.manager.UnregisterProfile(PROFILE_PATH, timeout=5)
            except dbus.DBusException:
                pass
            self.registered = False

    def publish(self):
        if self.mode is None:
            return
        line = {
            "modes": True,
            "mode": self.mode,
            "available": list(self.model["available"]),
        }
        if self.battery:
            line["battery"] = dict(self.battery)
        if line != self.last_line:
            self.last_line = line
            emit(line)

    def register(self):
        try:
            device_path = find_device_path(self.bus, self.address)
        except dbus.DBusException as error:
            return self.finish(EXIT_TRANSIENT,
                               "cannot reach BlueZ: %s" % error.get_dbus_message())
        if not device_path:
            return self.finish(EXIT_TRANSIENT,
                               "no paired device with address %s" % self.address)
        self.device = dbus.Interface(
            self.bus.get_object("org.bluez", device_path), "org.bluez.Device1")
        self.manager = dbus.Interface(
            self.bus.get_object("org.bluez", "/org/bluez"), "org.bluez.ProfileManager1")
        try:
            self.manager.RegisterProfile(PROFILE_PATH, UUID, {
                "Name": "Cornerstone Phones Moto Buds",
                "Role": "client",
                "RequireAuthentication": dbus.Boolean(False),
                "RequireAuthorization": dbus.Boolean(False),
                "AutoConnect": dbus.Boolean(False),
            }, timeout=5)
        except dbus.DBusException as error:
            return self.finish(EXIT_TRANSIENT,
                               "cannot register the Moto profile: %s"
                               % error.get_dbus_message())
        self.registered = True
        GLib.timeout_add(CONNECT_DELAY, self.connect, 0)
        return False

    def connect(self, attempt):
        if self.exit_code is not None or self.fd is not None:
            return False

        def failed(error):
            if self.exit_code is not None or self.fd is not None:
                return
            if attempt + 1 < CONNECT_ATTEMPTS:
                GLib.timeout_add(CONNECT_RETRY, self.connect, attempt + 1)
                return
            self.finish(EXIT_TRANSIENT, "cannot open the Moto channel: %s"
                        % error.get_dbus_message())

        try:
            self.device.ConnectProfile(UUID, reply_handler=lambda: None,
                                       error_handler=failed, timeout=CONNECT_TIMEOUT)
        except dbus.DBusException as error:
            failed(error)
        return False

    def opened(self, fd):
        if self.fd is not None or self.exit_code is not None:
            try:
                os.close(fd)
            except OSError:
                pass
            return
        self.fd = fd
        self.watch = GLib.io_add_watch(fd, GLib.PRIORITY_DEFAULT,
                                       GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR,
                                       self.on_io)
        # Handshake + first reads (Android app order, light version).
        self.write(encode(OP_PROFILE))
        self.write(encode(OP_FEATURES, bytes.fromhex("fcff0500")))
        self.write(encode(OP_BATTERY))
        self.write(encode(OP_ANC_GET))
        GLib.timeout_add(ASK_AGAIN_MS, self.ask_again)
        GLib.timeout_add(FIRST_ANSWER_MS, self.first_answer_timeout)
        GLib.timeout_add(POLL_MS, self.poll)

    def ask_again(self):
        if self.mode is None and self.exit_code is None:
            self.write(encode(OP_ANC_GET))
            self.write(encode(OP_BATTERY))
        return False

    def poll(self):
        if self.exit_code is not None or self.fd is None:
            return False
        self.write(encode(OP_ANC_GET))
        self.write(encode(OP_BATTERY))
        return True

    def first_answer_timeout(self):
        if self.exit_code is None and self.mode is None:
            self.finish(EXIT_UNSUPPORTED,
                        "the Moto buds did not answer the listening-mode query")
        return False

    def write(self, frame):
        if self.fd is None or self.exit_code is not None:
            return
        try:
            written = 0
            while written < len(frame):
                written += os.write(self.fd, frame[written:])
        except OSError as error:
            self.finish(EXIT_TRANSIENT, "the Moto channel closed: %s" % error)

    def on_frame(self, opcode, typ, result, payload):
        if opcode in (OP_ANC_GET, OP_ANC_NTF) or (opcode == OP_ANC_SET and typ == TYPE_NTF):
            mode = parse_anc(payload)
            if mode is not None and mode in self.model["available"]:
                self.mode = mode
                self.publish()
            return
        if opcode == OP_ANC_SET and typ == TYPE_RSP:
            # Empty ack; wait for 0x0204 or re-get.
            self.write(encode(OP_ANC_GET))
            return
        if opcode in (OP_BATTERY, OP_BATTERY_NTF):
            batt = parse_battery(payload)
            if batt is not None:
                self.battery = batt
                self.publish()
            return

    def parse_buffer(self):
        for opcode, typ, result, payload in take_frames(self.buffer):
            if self.exit_code is not None:
                return
            self.on_frame(opcode, typ, result, payload)

    def command(self, line):
        parts = line.strip().split()
        if len(parts) != 2 or parts[0] != "set":
            return
        if parts[1] not in self.model["set"]:
            return
        if self.mode is None or self.exit_code is not None:
            return
        self.write(encode(OP_ANC_SET, self.model["set"][parts[1]]))

    def on_io(self, _fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.finish(EXIT_TRANSIENT, "the Moto channel closed")
            return False
        try:
            data = os.read(self.fd, 4096)
        except OSError as error:
            self.finish(EXIT_TRANSIENT, "the Moto channel closed: %s" % error)
            return False
        if not data:
            self.finish(EXIT_TRANSIENT, "the Moto channel closed")
            return False
        self.buffer += data
        self.parse_buffer()
        return self.exit_code is None

    def listen_to_stdin(self):
        GLib.io_add_watch(0, GLib.PRIORITY_DEFAULT,
                          GLib.IO_IN | GLib.IO_HUP | GLib.IO_ERR, self.on_stdin)

    def on_stdin(self, _fd, condition):
        if condition & (GLib.IO_HUP | GLib.IO_ERR):
            self.finish(0)
            return False
        try:
            chunk = os.read(0, 4096)
        except OSError:
            self.finish(0)
            return False
        if not chunk:
            self.finish(0)
            return False
        for line in chunk.decode("utf-8", "replace").splitlines():
            self.command(line)
        return True


def main(argv):
    if len(argv) == 2 and argv[1] in ("-h", "--help"):
        sys.stdout.write(USAGE + "\n")
        return 0
    if len(argv) != 3:
        emit({"modes": False, "error": USAGE})
        return EXIT_SETUP
    address, name = argv[1], argv[2]
    if not ADDRESS.match(address):
        emit({"modes": False, "error": "not a Bluetooth address: %s" % address})
        return EXIT_SETUP
    if name not in MODELS:
        emit({"modes": False, "error": "no Moto model row for %r" % name})
        return EXIT_SETUP

    arm_parent_death_signal()
    dbus.mainloop.glib.DBusGMainLoop(set_as_default=True)
    bus = dbus.SystemBus()
    loop = GLib.MainLoop()
    bridge = Bridge(bus, address, name, loop)

    class Profile(dbus.service.Object):
        def __init__(self):
            dbus.service.Object.__init__(self, bus, PROFILE_PATH)

        @dbus.service.method("org.bluez.Profile1", in_signature="", out_signature="")
        def Release(self):
            bridge.finish(EXIT_TRANSIENT, "BlueZ released the Moto profile")

        @dbus.service.method("org.bluez.Profile1", in_signature="oha{sv}",
                             out_signature="")
        def NewConnection(self, path, fd, properties):
            bridge.opened(fd.take())

        @dbus.service.method("org.bluez.Profile1", in_signature="o", out_signature="")
        def RequestDisconnection(self, path):
            bridge.finish(EXIT_TRANSIENT, "the Moto channel closed")

    Profile()
    bridge.listen_to_stdin()
    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGTERM,
                    lambda *_: bridge.finish(0) or False)
    unix_signal_add(GLib.PRIORITY_DEFAULT, signal.SIGINT,
                    lambda *_: bridge.finish(0) or False)
    bridge.register()
    try:
        loop.run()
    finally:
        bridge.unregister()
    return bridge.exit_code if bridge.exit_code is not None else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
